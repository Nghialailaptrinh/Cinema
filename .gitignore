# Maven build output
/target/

# Maven Wrapper: keep wrapper scripts and configuration tracked
# (Do not ignore .mvn/wrapper/maven-wrapper.jar if the project uses it.)

# Java compiled/package files
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar

# Logs and runtime output
*.log
logs/

# Local environment and secrets
.env
.env.*
!.env.example

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse
.classpath
.project
.settings/
.factorypath

# VS Code local state
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary/editor files
*.swp
*.swo
*~
